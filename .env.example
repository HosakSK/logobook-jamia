# ==============================================================================
# LOGOBOOK - Environment Configuration Template
# ==============================================================================

# --- PocketBase Backend ---
# If using docker-compose.yml: http://localhost:8080 (or http://127.0.0.1:8080)
# If using standalone PocketBase binary: http://127.0.0.1:8090
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8080
POCKETBASE_INTERNAL_URL=http://pocketbase:8080
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me-to-a-secure-password

# --- Multi-tenant Root Domains (Comma-separated for multi-domain support) ---
# Subdomains like demo.yourdomain.com will automatically be resolved to brand "demo"
NEXT_PUBLIC_APP_DOMAIN=logobook.eu,logobook.sk,localhost

# --- GitHub Version Checker (22.01) ---
NEXT_PUBLIC_GITHUB_REPO=HosakSK/logobook-jamia

# --- Lemon Squeezy Payments (21.01) ---
# Merchant of Record for EU/Global VAT and automated invoicing
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=your_lemonsqueezy_store_id
LEMONSQUEEZY_STORE_SLUG=your_store_slug
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_hmac_secret
LEMONSQUEEZY_SANDBOX=true

# Optional specific Variant IDs from Lemon Squeezy dashboard:
# LEMONSQUEEZY_VARIANT_COMPANY_MONTHLY=12345
# LEMONSQUEEZY_VARIANT_COMPANY_YEARLY=12346
# LEMONSQUEEZY_VARIANT_FREELANCER_MONTHLY=12347
# LEMONSQUEEZY_VARIANT_FREELANCER_YEARLY=12348
# LEMONSQUEEZY_VARIANT_AGENCY_MONTHLY=12349
# LEMONSQUEEZY_VARIANT_AGENCY_YEARLY=12350
# LEMONSQUEEZY_VARIANT_PLATINUM_MONTHLY=12351
# LEMONSQUEEZY_VARIANT_PLATINUM_YEARLY=12352

# --- Resend Transactional Email (21.01) ---
RESEND_API_KEY=your_resend_api_key

# --- S3 / Cloudflare R2 Storage (Optional for external asset storage) ---
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=logobook-assets
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_PUBLIC_URL=https://assets.yourdomain.com

# --- Server Settings ---
PORT=3000
NODE_ENV=production
